# Safe local values for MyDevLab. Do not use generic DB_* variables.
MYDEVLAB_POSTGRES_DB=mydevlab
MYDEVLAB_POSTGRES_USER=mydevlab
MYDEVLAB_POSTGRES_PASSWORD=mydevlab_local_password
MYDEVLAB_DATABASE_URL=postgresql://mydevlab:mydevlab_local_password@postgres:5432/mydevlab

# Bootstrap & Seed do Founder (opcional para customização local)
MYDEVLAB_FOUNDER_EMAIL=
MYDEVLAB_FOUNDER_NAME=
MYDEVLAB_FOUNDER_PASSWORD=
MYDEVLAB_RECOVERY_EMAIL=
MYDEVLAB_RECOVERY_SECRET=

